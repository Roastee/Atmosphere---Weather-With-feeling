{
  "name": "atmosphere-weather",
  "private": true,
  "version": "0.1.0",
  "description": "A calm, transparent weather workspace with live forecasts, air-quality context, and resilient maps.",
  "homepage": "https://atmosphere-weather-amber.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/Roastee/Atmosphere---Weather-With-feeling.git"
  },
  "bugs": {
    "url": "https://github.com/Roastee/Atmosphere---Weather-With-feeling/issues"
  },
  "keywords": ["weather", "forecast", "air-quality", "react", "typescript", "leaflet", "open-meteo"],
  "type": "module",
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.1.2",
    "leaflet": "1.9.4",
    "lucide-react": "1.56.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "8.3.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/leaflet": "1.9.22",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
